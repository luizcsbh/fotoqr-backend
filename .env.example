# =============================================================================
# AMBIENTE
# =============================================================================
NODE_ENV=development
PORT=3001

# =============================================================================
# URLs
# =============================================================================
# Em desenvolvimento: http://localhost:5173
# Em produção (Netlify): https://seu-app.netlify.app
FRONTEND_URL=http://localhost:5173

# Em desenvolvimento: http://localhost:3001
# Em produção (Render): https://seu-backend.onrender.com
BACKEND_PUBLIC_URL=http://localhost:3001

# =============================================================================
# CORS
# =============================================================================
# Origens separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://seu-app.netlify.app

# =============================================================================
# BANCO DE DADOS (Neon PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# =============================================================================
# SEGURANÇA
# =============================================================================
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=sua-chave-jwt-minimo-32-caracteres
SESSION_SECRET=sua-chave-de-sessao-minimo-32-caracteres

# =============================================================================
# UPLOAD DE FOTOS
# =============================================================================
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=20
MAX_UPLOADS_PER_MINUTE=60   # Use 10 em produção

# =============================================================================
# EVENTOS / CHECK-IN
# =============================================================================
# Horas após o término do evento em que os convites ainda são aceitos na portaria
CHECKIN_GRACE_HOURS=6

# =============================================================================
# E-MAIL (Brevo)
# Recomendado: API HTTPS do Brevo (funciona no Render gratuito, que bloqueia portas SMTP 25/465/587)
# Chave em: Brevo → SMTP & API → aba "API Keys"
# =============================================================================
BREVO_API_KEY=xkeysib-...

# Remetente: precisa ser um e-mail verificado em Brevo → Senders, Domains & Dedicated IPs
SMTP_FROM="Seu App <noreply@seudominio.com>"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=seu-usuario-smtp@smtp-brevo.com
SMTP_PASS=sua-senha-smtp

# =============================================================================
# MODERAÇÃO AUTOMÁTICA DE FOTOS (Sightengine) — opcional
# Sem estas duas variáveis a moderação fica DESLIGADA
# Cadastro em: https://sightengine.com
# =============================================================================
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Confiança (0–1): a partir de REVIEW vai para a fila do anfitrião; a partir de AUTO_REJECT é recusada automaticamente
MODERATION_REVIEW_THRESHOLD=0.6
MODERATION_AUTO_REJECT_THRESHOLD=0.9

# =============================================================================
# SPOTIFY (integração de playlist — opcional)
# Cadastro em: https://developer.spotify.com/dashboard
# =============================================================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# =============================================================================
# SUPER ADMIN (Acesso irrestrito a todos os eventos da plataforma)
# =============================================================================
SUPER_ADMIN_EMAIL=admin@fotoqr.com
SUPER_ADMIN_PASSWORD=sua-senha-super-admin

