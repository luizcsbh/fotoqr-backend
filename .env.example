NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,https://fotoqreventos.netlify.app
BACKEND_PUBLIC_URL=http://localhost:3001
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=your-session-secret-at-least-32-chars-long
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=20
MAX_UPLOADS_PER_MINUTE=60
# Horas após o término do evento em que os convites ainda são aceitos na portaria
CHECKIN_GRACE_HOURS=6

# E-mail. Recomendado: API HTTPS do Brevo (funciona no Render gratuito, que bloqueia as portas SMTP 25/465/587)
# Brevo -> SMTP & API -> aba "API Keys" -> gerar chave (começa com xkeysib-)
BREVO_API_KEY=
# Remetente: precisa ser um e-mail verificado em Brevo -> Senders, Domains & Dedicated IPs
SMTP_FROM="FotoQR Eventos" <seu-email-verificado@seudominio.com>
# Alternativa SMTP (sem BREVO_API_KEY). No Render gratuito use a porta 2525
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
