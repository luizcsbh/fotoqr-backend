{
  "name": "fotoqr-backend",
  "version": "1.0.0",
  "description": "Backend API for FotoQR photo sharing application",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
