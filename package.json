    "reset-password": "tsx src/scripts/reset-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "drizzle-kit push"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "uuid": "^11.1.0"
